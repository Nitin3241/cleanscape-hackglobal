# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# Vultr Serverless Inference (OpenAI-compatible). Get the key and a model name from the
# Vultr Console: Products > Serverless Inference.
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=your-vultr-inference-key
LLM_MODEL=a-model-from-your-vultr-inference-dashboard

# Optional: replace Earthy's built-in instructions (see EARTHY_CONTEXT in main.py)
# SYSTEM_PROMPT=

# Optional: speech model for voice questions. "base" fits a 1 GB server; "small" is better for Arabic.
# WHISPER_MODEL=base

# Optional: Earthy's voice. Open /api/voices on the running server to see the choices.
# STT_MODEL=whisper-large-v3-turbo
# TTS_MODEL=qwen3-tts-12hz-1.7b
# TTS_VOICE=aiden
# ARABIC_TTS_MODEL=chatterbox
# ARABIC_TTS_VOICE=default
