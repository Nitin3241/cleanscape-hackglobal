{
  "_readme": "The one file to edit. Change a sound or an active take, then run tools/synth/build.sh. All original: no Apple or other third-party audio is sampled or embedded. Notes must stay in D major pentatonic (D E F# A B). To use your own recording, see tools/synth/recordings/README.md.",
  "active_takes": {
    "done": "b"
  },
  "takes": {
    "done": {
      "a": {
        "label": "Take A",
        "words": "Soft bell, 170 ms between strikes.",
        "gap_ms": 170,
        "decay_ms": 120,
        "lowpass_hz": 6000
      },
      "b": {
        "label": "Take B",
        "words": "Warmer and quicker, 150 ms between strikes.",
        "gap_ms": 150,
        "decay_ms": 105,
        "lowpass_hz": 4500
      },
      "c": {
        "label": "Take C",
        "words": "Brighter and more open, 190 ms between strikes.",
        "gap_ms": 190,
        "decay_ms": 135,
        "lowpass_hz": 7000
      }
    }
  },
  "peak_limit_dbfs": -6,
  "sounds": {
    "cs-done": {
      "name": "cs.done",
      "kind": "bell",
      "length_ms": 520,
      "target_lufs": -20,
      "uses": "The confirmation sound: done, that worked.",
      "strikes": [
        {
          "notes": [
            "D6",
            "F#6"
          ]
        },
        {
          "notes": [
            "A6"
          ],
          "db": -3
        }
      ]
    },
    "cs-done-single": {
      "name": "cs.done.single",
      "kind": "bell",
      "length_ms": 200,
      "target_lufs": -20,
      "strikes": [
        {
          "notes": [
            "A6"
          ]
        }
      ]
    },
    "cs-done-reward": {
      "name": "cs.done.reward",
      "kind": "bell",
      "length_ms": 720,
      "target_lufs": -20,
      "strikes": [
        {
          "notes": [
            "D6",
            "F#6"
          ]
        },
        {
          "notes": [
            "A6"
          ],
          "db": -3
        },
        {
          "notes": [
            "D7"
          ],
          "db": -11
        }
      ]
    },
    "cs-gentle": {
      "name": "cs.gentle",
      "kind": "bell",
      "length_ms": 320,
      "lowpass_hz": 2600,
      "target_lufs": -26,
      "strikes": [
        {
          "notes": [
            "D5"
          ]
        }
      ]
    }
  },
  "default_on": [
    "cs-done",
    "cs-done-reward"
  ],
  "signatures": {
    "done": {
      "words": "Two taps matching the two strikes",
      "steps": [
        {
          "at": 0,
          "style": "medium"
        },
        {
          "at": 150,
          "style": "light"
        }
      ],
      "ahap": {
        "transients": [
          [
            0,
            0.6,
            0.5
          ],
          [
            0.15,
            0.45,
            0.5
          ]
        ]
      },
      "android": {
        "timings": [
          20,
          130,
          15
        ],
        "amplitudes": [
          180,
          0,
          120
        ],
        "fallback": "EFFECT_DOUBLE_CLICK"
      }
    }
  },
  "haptic_words": {
    "none": "None",
    "selection": "Selection tick",
    "impact:light": "Light impact",
    "impact:soft": "Soft impact",
    "impact:medium": "Medium impact",
